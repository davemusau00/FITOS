NODE_ENV=development
APP_ENV=local

WEB_PORT=5173
API_PORT=3000
WEB_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://fitos:fitos@localhost:5432/fitos
TEST_DATABASE_URL=postgresql://fitos:fitos@localhost:5433/fitos_test
REDIS_URL=redis://localhost:6379

# Replace before staging/production. API refuses known development values there.
SESSION_SECRET=local-development-only-change-me
CSRF_SECRET=local-development-only-change-me
SESSION_TTL_SECONDS=28800

DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES
LOG_LEVEL=debug
FITOS_REPOSITORY=memory

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.test

# Manual payment recording is the default MVP. Provider credentials remain disabled.
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=

WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

ERROR_REPORTING_DSN=
